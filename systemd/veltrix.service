[Unit]
Description=Veltrix web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=veltrix
Group=veltrix
WorkingDirectory=/opt/veltrix
EnvironmentFile=-/etc/veltrix.env
ExecStart=/opt/veltrix/.venv/bin/python -m outpanel.app
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/veltrix/data /opt/veltrix/backups

[Install]
WantedBy=multi-user.target
